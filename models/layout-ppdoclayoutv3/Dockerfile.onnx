# PP-DocLayoutV3 nad ONNX Runtime (CPU), bez PyTorch v běhovém obrazu.
# Stupeň 1 převede model do ONNX (potřebuje torch), stupeň 2 obsahuje jen ONNX Runtime.
#   docker build -f Dockerfile.onnx .
#   dotrénovaný model: --build-arg MODEL_ID=… --build-arg MODEL_REVISION=…
FROM python:3.12-slim AS export
ARG MODEL_ID=PaddlePaddle/PP-DocLayoutV3_safetensors
ARG MODEL_REVISION=e4f489dc536556fc1be02b973ba06756e0d4a2ac
ENV PIP_NO_CACHE_DIR=1
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch==2.9.1 torchvision==0.24.1
RUN pip install transformers==5.23.0 opencv-python-headless==4.12.0.88 "onnx==1.19.1" onnxscript pillow numpy
COPY export_onnx.py /src/
RUN python /src/export_onnx.py --model-id "${MODEL_ID}" --revision "${MODEL_REVISION}" --out /opt/model/model.onnx

FROM python:3.12-slim
ENV PIP_NO_CACHE_DIR=1 MODEL_PATH=/opt/model/model.onnx
COPY requirements-onnx.txt /tmp/
RUN pip install -r /tmp/requirements-onnx.txt
COPY --from=export /opt/model /opt/model
WORKDIR /app
COPY server_onnx.py .
RUN useradd --uid 1000 --create-home layout
USER layout
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s CMD python -c \
  "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"
CMD ["uvicorn", "server_onnx:app", "--host", "0.0.0.0", "--port", "8000"]
