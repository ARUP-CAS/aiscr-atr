{
 "openapi": "3.1.0",
 "info": {
  "title": "aiscr-atr",
  "description": "Otevřená služba ATR: z dokumentu (PDF, sken, obrázek) vytvoří `atr/docproc-json` (rozvržení, bloky s typem, polohou, pořadím čtení a textem; routing každé strany). Chyby mají tvar `{status, reason, detail}`: 400 neplatný požadavek, 422 nečitelný vstup nebo selhání rozpoznání (`all_engines_failed`), 503 nedostupná služba modelu (zopakovat), 500 neplatný výstup.",
  "license": {
   "name": "MIT"
  },
  "version": "0.1.0.dev0"
 },
 "paths": {
  "/health": {
   "get": {
    "summary": "Health",
    "operationId": "health_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Health Health Get"
        }
       }
      }
     }
    }
   }
  },
  "/info": {
   "get": {
    "summary": "Info",
    "operationId": "info_info_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Info Info Get"
        }
       }
      }
     }
    }
   }
  },
  "/convert": {
   "post": {
    "summary": "Convert",
    "operationId": "convert_convert_post",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_convert_convert_post"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Body_convert_convert_post": {
    "properties": {
     "file": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "File"
     },
     "forced_pages": {
      "type": "string",
      "title": "Forced Pages",
      "description": "JSON {\"číslo strany\": \"důvod\"}",
      "default": "{}"
     },
     "sha512": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sha512"
     },
     "paradata": {
      "type": "boolean",
      "title": "Paradata",
      "description": "vrátit {docproc, paradata} místo samotného výstupu",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "file"
    ],
    "title": "Body_convert_convert_post"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}
